    def process_agent_action(self, action) -> BaseAction:
        """
        29/04/2025版本
        - 正值 (action > 0)：电网 -> 电池（充电，power 为正）
        - 负值 (action < 0)：电池 -> 电网（放电，power 为负）
        """
        obs = self.tracker.state

        battery_params = [
            {
                "max_charge_power": 7.5,  # MW
                "max_discharge_power": 7.5,
                "capacity": 15.0,  # MWh
                "charge_eff": 0.95,  # 假设效率不为 1
                "discharge_eff": 0.95
            },
            {
                "max_charge_power": 3.5,
                "max_discharge_power": 3.5,
                "capacity": 7.0,
                "charge_eff": 0.95,
                "discharge_eff": 0.95
            }
        ]

        # 把动作限定在 [-1, 1]
        action = np.clip(action, -1.0, 1.0)
        set_storage = []

        for i, act in enumerate(action):
            params = battery_params[i]
            soc = obs.storage_charge[i] / params["capacity"]

            # SOC 边界
            if act >= 0 and soc >= 0.99:
                power = 0.0
            elif act <= 0 and soc <= 0.01:
                power = 0.0
            else:
                if act > 0:
                    # 充电：电网给出的有功 P_grid = act * P_max
                    # 电池端实际吸收 P_batt = P_grid * eff_charge
                    p_grid = act * params["max_charge_power"]
                    power = p_grid * params["charge_eff"]
                elif act < 0:
                    # 放电：电池端释放 P_batt = (-act) * P_max
                    # 电网端接收 P_grid = P_batt * eff_discharge
                    p_batt = (-act) * params["max_discharge_power"]
                    power = - p_batt * params["discharge_eff"]
                else:
                    power = 0.0

            set_storage.append([i, power])

        return self.env.action_space({"set_storage": set_storage})
